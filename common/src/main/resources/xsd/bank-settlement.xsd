<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:tns="http://recon.dev/bank/settlement"
           targetNamespace="http://recon.dev/bank/settlement"
           elementFormDefault="qualified">

    <xs:element name="getSettlementStatusRequest">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="utr" type="xs:string"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>

    <xs:element name="getSettlementStatusResponse">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="utr" type="xs:string"/>
                <!-- CREDITED, DUPLICATE_CREDIT or NOT_FOUND -->
                <xs:element name="status" type="xs:string"/>
                <xs:element name="creditCount" type="xs:int"/>
                <xs:element name="amountMinor" type="xs:long"/>
                <xs:element name="currency" type="xs:string"/>
                <xs:element name="valueDate" type="xs:string" minOccurs="0"/>
                <xs:element name="bankRef" type="xs:string" minOccurs="0"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>
</xs:schema>
