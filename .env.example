# Copy to .env (scripts/demo.sh does this automatically). Local demo values only - never real secrets.
POSTGRES_DB=recon
POSTGRES_USER=recon
POSTGRES_PASSWORD=recon_local_only
# Host port for Postgres (5433 avoids clashing with a locally installed Postgres on 5432)
POSTGRES_HOST_PORT=5433

# HMAC key for signing JWTs (>= 32 bytes). Generate your own: openssl rand -base64 48
JWT_SECRET=local-demo-jwt-secret-change-me-0123456789abcdef

# Demo users seeded on first start (one per role)
DEMO_ANALYST_PASSWORD=analyst-demo-pass
DEMO_SUPERVISOR_PASSWORD=supervisor-demo-pass
DEMO_ADMIN_PASSWORD=admin-demo-pass

# LocalStack accepts any credentials; these are placeholders, not AWS keys
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_REGION=ap-south-1
S3_BUCKET=recon-data
